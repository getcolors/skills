{
    servers {
        # Behind a proxy every connection arrives from the edge, so without this
        # Caddy attributes each request to its immediate peer and the access log
        # records the CDN instead of the visitor -- useless for the one question
        # it gets read for. These ranges MUST describe whatever actually sits in
        # front of the origin; see trusted_proxy_ranges in group_vars/all.yml.
        #
        # This affects what Caddy sees and logs, not what Rybbit stores: the
        # application reads X-Forwarded-For itself, so event attribution is
        # correct either way.
        trusted_proxies static {{ trusted_proxy_ranges | join(' ') }}
    }
}

{{ rybbit_host }} {
    encode zstd gzip
    request_body max_size 10MB

    # Caddy logs nothing for a successful request by default, so an analytics
    # endpoint whose whole job is receiving requests had no request-level
    # evidence that anything ever arrived. Log to stdout, where docker logs
    # reads; the compose service bounds the file so a busy endpoint cannot fill
    # the disk.
    log {
        output stdout
        format json
    }

    handle /api/* {
        reverse_proxy backend:3001
    }

    handle /.well-known/oauth-* {
        reverse_proxy backend:3001
    }
    handle /.well-known/openid-configuration* {
        reverse_proxy backend:3001
    }

    handle {
        reverse_proxy client:3002
    }
}
