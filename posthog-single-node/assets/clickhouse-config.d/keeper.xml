<!--
  Mounted at /etc/clickhouse-server/config.d/keeper.xml.

  PostHog's migrate_clickhouse calls database.migrate(..., replicated=True) with
  no way to opt out, so every table it creates is a ReplicatedMergeTree. Those
  need coordination metadata, and without it the very first CREATE TABLE - the
  migration history table itself - dies with "There is no Zookeeper
  configuration in server config".

  Upstream runs a separate ZooKeeper. A single node does not need one:
  ClickHouse Keeper runs inside the same server on 9181 with a one-member raft
  configuration, which costs no extra container on a box that is already tight.
  Keeper stays on loopback because it runs inside this server, not across the
  container network - unlike remote_servers in clusters.xml, which must use the
  compose service name.
-->
<clickhouse>
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>127.0.0.1</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
    <zookeeper>
        <node>
            <host>127.0.0.1</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <!--
        posthog/clickhouse/cluster.py selects hosts with
        `getMacro('hostClusterType')` and `getMacro('hostClusterRole')` and
        filters them as

            (role in requested_roles or ALL in requested_roles)
            and (type == workload or workload == DEFAULT)

        so ALL is a wildcard on the requesting side, not the host side: a node
        labelled "all" matches only callers that pass ALL, while "data" matches
        both DATA and ALL. "online" covers the ONLINE workload and DEFAULT
        bypasses the check.

        Upstream ships these macros from its own deployment tooling rather than
        from docker/clickhouse/config.xml, so a single node has to declare them
        itself. Without them migrate_clickhouse dies with "No macro
        hostClusterType in config" - after having created tables successfully,
        so it looks like a late failure rather than a missing config.

        shard/replica supply the {shard}/{replica} substitutions the replicated
        table paths are built from.
    -->
    <macros>
        <shard>1</shard>
        <replica>replica-1</replica>
        <hostClusterType>online</hostClusterType>
        <hostClusterRole>data</hostClusterRole>
    </macros>
</clickhouse>
