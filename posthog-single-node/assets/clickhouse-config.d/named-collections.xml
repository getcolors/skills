<!--
  Mounted at /etc/clickhouse-server/config.d/named-collections.xml.

  PostHog's ClickHouse schema includes Kafka engine tables, and their connection
  details come from named collections rather than inline settings. Every name a
  migration references must resolve or the migration fails with
  NAMED_COLLECTION_DOESNT_EXIST - which means the broker is required for the
  schema to exist at all, not merely for events to flow.

  Only six of these are discoverable from posthog/settings/data_stores.py
  (CLICKHOUSE_KAFKA_NAMED_COLLECTION defaults to msk_cluster, and newer
  migrations use the warpstream_* names). The remaining two are named directly
  by migrations. This is the full authoritative set of eight from upstream's own
  docker/clickhouse/config.d/default.xml - track that file rather than adding
  names one failed converge at a time. Discovering them by trial costs a full
  migrate_clickhouse run each, and the run reaches ~267 tables before it fails.
-->
<clickhouse>
    <named_collections>
        <msk_cluster>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </msk_cluster>
        <warpstream_ingestion>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_ingestion>
        <warpstream_calculated_events>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_calculated_events>
        <warpstream_replay>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_replay>
        <warpstream_shared>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_shared>
        <warpstream_cyclotron>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_cyclotron>
        <warpstream_logs>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_logs>
        <warpstream_traces>
            <kafka_broker_list>kafka:9092</kafka_broker_list>
        </warpstream_traces>
    </named_collections>
</clickhouse>
